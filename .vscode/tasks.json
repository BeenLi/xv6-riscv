{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "start-qemu",
            "type": "shell",
            "command": "qemu-system-riscv64",
            "args": [
                "-machine", "virt",
                "-bios", "none",
                "-kernel", "/home/maclee/xv6-riscv/kernel/kernel",
                "-m", "128M",
                "-smp", "1",
                "-nographic",
                "-global", "virtio-mmio.force-legacy=false",
                "-drive", "file=fs.img,if=none,format=raw,id=x0",
                "-device", "virtio-blk-device,drive=x0,bus=virtio-mmio-bus.0",
                "-S",
                "-gdb", "tcp::26000"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}